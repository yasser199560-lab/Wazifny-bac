# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=wazifny
# MongoDB performance / failure bounds (milliseconds, plus pool sizes).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=1

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI: Gemini (optional, higher-accuracy CV field extraction) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Notifications ---
# Create a Resend API key and verify your sending domain (with SPF + DKIM).
# A free Resend account allows 3,000 emails/month (100/day).
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
# Do not use a personal Gmail/Outlook/Yahoo address here.
RESEND_FROM_EMAIL=notifications@yourdomain.com
RESEND_FROM_NAME=Wazifny
RESEND_REPLY_TO=support@yourdomain.com
# Reset emails must point to the public HTTPS frontend, never localhost.
FRONTEND_URL=https://app.yourdomain.com
